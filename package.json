{
  "name": "overlock-two-app-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch platform/bobbin/server/start.ts",
    "dev:topology": "tsx watch platform/simulation/start-local.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{platform,applications,tests}/**/*.{ts,tsx,css,md}\" \"*.{json,md,html,ts}\"",
    "start": "tsx platform/bobbin/server/start.ts",
    "start:topology": "tsx platform/simulation/start-local.ts",
    "start:container": "tsx platform/simulation/start-container.ts",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:build": "tsx --test tests/build-artifacts.check.ts",
    "check": "npm run test && npm run build && npm run test:build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "single-spa": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
